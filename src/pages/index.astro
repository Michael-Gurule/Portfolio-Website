---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/writing';

const latestArticles = (await getArticles()).slice(0, 3);
---

<BaseLayout
    title="Michael Gurule, Applied Scientist and ML Architect"
    description="I build statistical and machine learning systems for data that arrives noisy, fast, and shifting, and I design the cloud systems that keep them working after launch."
    keywords="data science, machine learning engineer, anomaly detection, time series, Bayesian statistics, optimization, information theory, production ML, real-time ML, MLOps, trading, telemetry, AWS, GCP"
    ogDescription="I build statistical models for noisy, sparsely labeled, shifting data, and design the cloud systems that keep them working after launch."
    path="/"
    twitterText
    onHome
    backToTop="#hero"
>
    <Fragment slot="head">
    <!-- Intro plays once per session, from the top of a fresh load, unless motion is reduced -->
    <script is:inline>
        (function () {
            try {
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
                if (location.hash || sessionStorage.getItem('mg-intro')) return;
                sessionStorage.setItem('mg-intro', '1');
                document.documentElement.classList.add('intro-active');
            } catch (e) { }
        })();
    </script>

    <!-- Structured Data for SEO -->
    <script is:inline type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Michael Gurule",
    "jobTitle": "Applied Scientist and ML Architect",
    "url": "https://michaelgurule.com",
    "sameAs": [
      "https://linkedin.com/in/michael-gurule-denver",
      "https://github.com/michael-gurule"
    ]
  }
  </script>
    </Fragment>

    <Fragment slot="before-nav">
    <!-- Intro overlay (decorative) -->
    <div class="intro" aria-hidden="true">
        <div class="intro-inner">
            <span class="intro-name">Michael Gurule</span>
            <span class="intro-title">Applied Scientist and ML Architect</span>
        </div>
    </div>
    </Fragment>

    <main>
    <!-- Hero Section -->
    <section class="hero" id="hero">
        <div class="container">
            <h1 class="hero-title">Michael Gurule</h1>
            <p class="hero-kicker">Applied Scientist and ML Architect</p>
            <p class="hero-lead">Most of the difficulty in operational data shows up before the model does.</p>
            <p class="hero-summary">
                I build statistical models for noisy, sparsely labeled, shifting data, and design the cloud systems
                that keep them working after launch.
            </p>

            <div class="hero-cta">
                <a href="#contact" class="btn btn-primary">Get in touch</a>
                <a href="#projects" class="btn btn-secondary">
                    Selected projects
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13.5 4.5L21 12M21 12L13.5 19.5M21 12H3" />
                    </svg>
                </a>
            </div>

            <div class="hero-social">
                <a href="https://github.com/michael-gurule" target="_blank" rel="noopener">GitHub</a>
                <a href="https://linkedin.com/in/michael-gurule-denver" target="_blank" rel="noopener">LinkedIn</a>
                <a href="https://medium.com/@michaelgurule1164" target="_blank" rel="noopener">Medium</a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section class="section about" id="about">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">About</h2>
            <div class="about-content">
                <p class="about-role fade-in" data-reveal="left">
                    Building the models and automation that put machine learning
                    <span class="about-role-accent">inside live trading decisions.</span>
                </p>
                <div class="about-text fade-in fade-in-delay-1" data-reveal="right">
                    <p class="about-body">
                        Now I build machine learning and automation for a sports trading operation, taking routine
                        decisions off traders and surfacing the ones that need a person. Before that I led a greenfield
                        anomaly detection, correlation, and forecasting platform for a network of about 32 million
                        broadband endpoints. Earlier, I spent close to a decade in consulting and applied data science
                        across financial services, insurance risk, and industrial commodities, learning each industry
                        well enough to understand what its data was saying.
                    </p>
                    <a href="about/" class="text-link about-more" data-bio-open>
                        Read the full story
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M13.5 4.5L21 12M21 12L13.5 19.5M21 12H3" />
                        </svg>
                    </a>
                </div>
            </div>
            <dl class="about-facts fade-in" data-reveal="up">
                <div class="about-fact">
                    <dt class="mono-label">Now</dt>
                    <dd>Senior Data Scientist, AI and Automation</dd>
                </div>
                <div class="about-fact">
                    <dt class="mono-label">Education</dt>
                    <dd>MS Applied Mathematics<br>BS Finance and Risk</dd>
                </div>
                <div class="about-fact">
                    <dt class="mono-label">Certified</dt>
                    <dd>AWS Machine Learning Engineer</dd>
                </div>
                <div class="about-fact">
                    <dt class="mono-label">Based</dt>
                    <dd>Denver, CO</dd>
                </div>
            </dl>
        </div>
    </section>

    <!-- Current Work Section -->
    <section class="section current-work" id="current-work">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">Current Work</h2>
            <p class="section-subtitle fade-in fade-in-delay-1" data-reveal="left">
                Trading runs on fast decisions made against a market that never stops moving. The work is putting
                models inside those decisions: scoring what changes in real time, automating what traders shouldn't
                have to watch, and proving each change on live outcomes.
            </p>

            <div class="decisions">
                <div class="decision fade-in" data-reveal="up">
                    <h3>Signals a trader can act on</h3>
                    <p>Prices, liabilities, and betting activity shift by the second during a live event. Models score
                        those streams as they arrive and raise the movements worth a trader's attention, not every
                        movement.</p>
                </div>
                <div class="decision fade-in fade-in-delay-1" data-reveal="up">
                    <h3>Automation with people on the exceptions</h3>
                    <p>Routine adjustments move to automated pipelines with clear limits. Traders keep the judgment
                        calls, and their overrides feed back into training.</p>
                </div>
                <div class="decision fade-in fade-in-delay-2" data-reveal="up">
                    <h3>Measured on live outcomes</h3>
                    <p>Every model ships with an experiment design and production monitoring on GCP. A model earns its
                        place by what it changes in live trading, not by its score on a holdout set.</p>
                </div>
            </div>

            <h3 class="previous-title mono-label fade-in" data-reveal="left">Previously</h3>
            <ul class="figures fade-in" data-reveal="up">
                <li class="figure">
                    <span class="figure-value">~1B</span>
                    <span class="figure-label mono-label">series scored daily</span>
                </li>
                <li class="figure">
                    <span class="figure-value">6&ndash;12B</span>
                    <span class="figure-label mono-label">series in scope</span>
                </li>
                <li class="figure">
                    <span class="figure-value">8</span>
                    <span class="figure-label mono-label">network domains</span>
                </li>
            </ul>
            <p class="figures-note fade-in" data-reveal="up">
                A greenfield anomaly detection, correlation, and forecasting platform for broadband telemetry. I owned
                the modeling and AWS architecture as it grew from a single streaming app to calendar-aware detection
                and topology-based root-cause correlation in production, with forecasting and agentic operations next
                on the roadmap I set.
            </p>
        </div>
    </section>

    <!-- What I Work On Section -->
    <section class="section work" id="work">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">What I Work On</h2>

            <div class="work-grid">
                <div class="work-column fade-in fade-in-delay-1" data-reveal="scale">
                    <h3>Applied Science</h3>
                    <ul>
                        <li>Regression, splines, and generalized additive models</li>
                        <li>Bayesian and hierarchical models</li>
                        <li>Non-stationary time series and change-point detection</li>
                        <li>Survival analysis, Kalman filtering, and state estimation</li>
                    </ul>
                </div>

                <div class="work-column fade-in fade-in-delay-2" data-reveal="scale">
                    <h3>ML Architecture</h3>
                    <ul>
                        <li>Streaming and real-time inference on AWS and GCP</li>
                        <li>Root-cause correlation across network topology</li>
                        <li>Feature budgets under latency and compute limits</li>
                        <li>Validation under temporal dependence</li>
                        <li>Drift detection, automated tuning, and retraining</li>
                    </ul>
                </div>

                <div class="work-column fade-in fade-in-delay-3" data-reveal="scale">
                    <h3>Direction</h3>
                    <ul>
                        <li>Platform roadmaps from detection to agentic operations</li>
                        <li>Evaluation design and ground truth strategy</li>
                        <li>Release standards: SLAs, thresholds, promotion</li>
                        <li>Guardrails for automation acting on live decisions</li>
                    </ul>
                </div>
            </div>

            <p class="work-applied fade-in" data-reveal="up">
                Applied across sports trading, network and device telemetry, insurance risk, marketing attribution, satellite health,
                and multi-sensor positioning.
            </p>

            <div class="technical-ecosystem">
                <h3 class="ecosystem-title mono-label">Technical Ecosystem</h3>
                <!-- Rendered from data/stack.json -->
                <div class="tech-grid" data-stack-source="data/stack.json"></div>
            </div>
        </div>
    </section>

    <!-- Projects Section -->
    <section class="section projects" id="projects">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">Featured Work</h2>
            <p class="section-subtitle fade-in fade-in-delay-1" data-reveal="left">
                Systems built around sparse ground truth, non-stationary signal, and sensors that disagree.
            </p>

            <!-- Rendered from data/projects.json -->
            <div class="projects-stack" data-projects-source="data/projects.json"></div>

            <div class="projects-cta fade-in">
                <a href="https://github.com/michael-gurule" class="btn btn-secondary" target="_blank" rel="noopener">
                    View All Projects on GitHub
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13.5 4.5L21 12M21 12L13.5 19.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Writing Section -->
    <section class="section writing" id="writing">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">Writing</h2>
            <p class="section-subtitle fade-in fade-in-delay-1" data-reveal="left">
                Model breakdowns, practical guides, and how I approach problems in data.<br>
                Most of it comes back to where methods hold, where they break, and what to build around them.
            </p>

            <div class="article-grid">
                {latestArticles.map((article, i) => (
                    <ArticleCard article={article} headingLevel={3}
                        class={`fade-in${i ? ` fade-in-delay-${i}` : ''}`} />
                ))}
            </div>

            <div class="writing-cta fade-in">
                <a href="/writing/" class="btn btn-secondary">
                    All writing
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M13.5 4.5L21 12M21 12L13.5 19.5M21 12H3" />
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="section contact" id="contact">
        <div class="container">
            <h2 class="section-title fade-in" data-reveal="left">Contact</h2>
            <p class="section-subtitle fade-in fade-in-delay-1" data-reveal="left">
                The fastest way to reach me is email. I read everything and reply within a few days.
            </p>

            <div class="contact-actions fade-in fade-in-delay-2" data-reveal="up">
                <div class="contact-email">
                    <a href="mailto:michael@michaelgurule.com"
                        class="contact-email-link">michael@michaelgurule.com</a>
                    <button type="button" class="btn-copy" data-copy="michael@michaelgurule.com"
                        aria-label="Copy email address">Copy</button>
                    <span class="visually-hidden" role="status" aria-live="polite"></span>
                </div>
                <div class="contact-links">
                    <a href="https://linkedin.com/in/michael-gurule-denver" class="btn btn-secondary" target="_blank"
                        rel="noopener">LinkedIn</a>
                    <a href="/resume.pdf" class="btn btn-secondary" download>
                        Download resume
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 4v12M12 16l-5-5M12 16l5-5M5 20h14" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
    </main>

    <Fragment slot="after-footer">
    <!-- Bio card: filled from about/index.html when opened -->
    <dialog class="bio-dialog" id="bio-card" aria-labelledby="bio-title">
        <div class="bio-backdrop"></div>
        <div class="bio-card">
            <button type="button" class="bio-close" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
            <div class="bio-body prose"></div>
        </div>
    </dialog>
    </Fragment>
</BaseLayout>
